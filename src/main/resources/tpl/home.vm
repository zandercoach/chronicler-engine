<!DOCTYPE html>
<html lang="de">
  <head>
#parse("inc_head.vm")
  </head>

  <body>
#parse("inc_navigation.vm")

<!-- CONTENT -->
    <div class="container">
      <div class="chronicler-unit">
        <h1>$site.title</h1>
        <p>$site.welcome</p>
#foreach($member in $bean.members)
#if($foreach.index % 4 == 0)
        <p>
          <div class="row-fluid">
            <ul class="thumbnails">
#end
              <li class="span3">
                <h3>$member.name</h3>
                <a href="$resolver.resolveUrlFor($member)" class="thumbnail">
                  <img src="$resolver.resolveImageUrlFor($member)" alt="$member.name" id="img:held:$member.name.toLowerCase().replace(' ', '_')" />
                </a>
              </li>
#if($foreach.index % 4 == 3 || !$foreach.hasNext)
            </ul>
          </div>
        </p>
#end
#end
      </div>

      <div class="row">
        <div class="span12" id="teaser:endeavor">
          <h2>Letztes Abenteuer</h2>
          <hr />
#set( $endeavor = $bean.endeavor )
#parse("inc_endeavor_teaser.vm")
        </div>
      </div>

      <hr>

#parse("inc_footer.vm")
    </div> <!-- /container -->
    
#parse("inc_js.vm")
  </body>
</html>
