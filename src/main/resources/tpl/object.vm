<!DOCTYPE html>
<html lang="de">
  <head>
#parse("inc_head.vm")
  </head>

  <body>
#parse("inc_navigation.vm")

<!-- CONTENT -->
    <div class="container">
      <div class="row">
        <div class="span9">
          <h2>$bean.object.name</h2>
#if($bean.member && $bean.member.retired)
          <p class="chronicler-status"><em>$bean.member.status#if($bean.member.statusNote):#end</em>#if($bean.member.statusNote) $bean.member.statusNote#end</p>
#end
#if($bean.object.wikiPage && !$resolver.resolveWikiUrlFor($bean.object.wikiPage).isEmpty())
          (siehe auch <a href="$resolver.resolveWikiUrlFor($bean.object.wikiPage)" target="wiki" class="chronicler-wiki-link">$site.wikiName</a>)
#end
        <hr />
          <h4>Kurzbeschreibung</h4>
          $bean.object.description
        <hr />
          <h4>Ereignisse</h4>
#foreach($event in $bean.object.events)
#if($event.location)
          <h5>$event.date - $event.location.name - $event.title</h5>
#else
          <h5>$event.date - $event.title</h5>
#end
          $event.description
#end
#parse("inc_obj_${bean.object.class.simpleName}.vm")
        </div>
        <div class="span3">
#parse("inc_obj_references.vm")
        </div>
      </div>

      <hr />

#parse("inc_footer.vm")
    </div> <!-- /container -->
    
#parse("inc_js.vm")
  </body>
</html>
